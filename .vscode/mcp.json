{
  // VS Code MCP configuration for the SQL Auditor server.
  // GitHub Copilot Chat is the AI for EVALUATION: it invokes these tools and
  // orchestrates the conversation, and the server makes no LLM/API calls there.
  //
  // No secrets are stored here. Windows Authentication needs nothing extra.
  // Anything sensitive is read from the environment of the session that launches
  // VS Code, so it never lives in this file, in chat, in source, in logs, or in
  // result files:
  //   $env:SQLAUDITOR_SQL_PASSWORD = '...'   # SQL Authentication only
  //   $env:PROVIDER_BASE_URL = '...'         # 'generate_scripts' only:
  //   $env:MODEL             = '...'         #   it runs the ScriptGeneratorAgent
  //   $env:PROVIDER_API_KEY  = '...'         #   pipeline against your provider
  // Then start VS Code from that same session (`code .`).
  // Reload/Restart the server from the MCP view after editing this file.
  "servers": {
    "sql-auditor": {
      "type": "stdio",
      // Portable path: ${workspaceFolder} resolves to wherever this repo is
      // cloned, so it works on any machine/username. Build the server first:
      //   dotnet build "Backend/IDE/SQLAuditor.Mcp.csproj"
      "command": "${workspaceFolder}\\Backend\\IDE\\bin\\Debug\\net8.0\\SQLAuditor.Mcp.exe",
      // Run from the repo folder so the engine can locate the checklist and
      // write results/ (final_report.md, checklist_results.json).
      "cwd": "${workspaceFolder}"
    }
  }
}
