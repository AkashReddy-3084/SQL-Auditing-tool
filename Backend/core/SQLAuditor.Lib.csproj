<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\agents\**\*.cs" />
  </ItemGroup>
  <!-- Program.cs is the console entry point owned by the Exe project only. -->
  <ItemGroup>
    <Compile Remove="Program.cs" />
  </ItemGroup>
  <!-- Interface host code (CLI/IDE) has its own projects. -->
  <ItemGroup>
    <Compile Remove="..\agents\modules\CLI\**\*.cs" />
    <Compile Remove="..\agents\modules\IDE\**\*.cs" />
  </ItemGroup>

</Project>

