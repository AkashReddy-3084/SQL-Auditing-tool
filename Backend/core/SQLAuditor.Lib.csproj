<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\agents\**\*.cs" Exclude="..\agents\ScriptGeneratingAgent\**" />
  </ItemGroup>
  <!-- Program.cs is the console entry point owned by the Exe project only. -->
  <ItemGroup>
    <Compile Remove="Program.cs" />
  </ItemGroup>
  <!-- Interface host code (CLI/IDE) under application/ has its own projects. -->
  <ItemGroup>
    <Compile Remove="..\agents\modules\application\**\*.cs" />
  </ItemGroup>

</Project>

