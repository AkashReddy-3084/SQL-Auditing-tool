<Window x:Class="SQLAuditor.Wpf.CustomChecklistProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Checklist Progress"
        Height="700"
        Width="880"
        MinHeight="560"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#FFF4F7FB"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FF0F4C81" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#FFB91C1C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#FF1F2937" />
            <Setter Property="BorderBrush" Value="#FFCBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="HeaderText"
                   Text="Custom Checklist Progress"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#FF1F2937" />

        <TextBlock Grid.Row="1"
                   x:Name="StageText"
                   Text="Guardrails - Semantic Match Router - Area/Sub-area Classification - Script Generation - Approval - Merge"
                   FontSize="13"
                   Foreground="#FF6B7280"
                   TextWrapping="Wrap"
                   Margin="0,6,0,14" />

        <ProgressBar Grid.Row="2"
                     x:Name="Progress"
                     Height="12"
                     Minimum="0"
                     Maximum="100"
                     Value="0"
                     Foreground="#FF0F4C81"
                     Background="#FFE9EEF5"
                     Margin="0,0,0,16" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#FFE2E8F0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Processing log" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBox x:Name="LogBox"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#FFE2E8F0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="ReviewHeader" Text="Generated script" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock DockPanel.Dock="Top" x:Name="ReviewSummary" Text="No item is waiting for review." Foreground="#FF6B7280" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBox x:Name="ScriptBox"
                             IsReadOnly="True"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             BorderThickness="0"
                             Background="Transparent"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="RejectBtn"
                    Content="Reject"
                    Style="{StaticResource DangerButton}"
                    MinWidth="130"
                    IsEnabled="False"
                    Margin="0,0,10,0"
                    Click="RejectBtn_Click" />
            <Button x:Name="ApproveBtn"
                    Content="Approve and Add"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="170"
                    IsEnabled="False"
                    Click="ApproveBtn_Click" />
        </StackPanel>

        <DockPanel Grid.Row="5" LastChildFill="False" Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Left"
                       x:Name="SummaryText"
                       Text=""
                       Foreground="#FF1F2937"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right"
                    x:Name="ActionButton"
                    Content="Cancel"
                    Style="{StaticResource QuietButton}"
                    MinWidth="130"
                    Click="ActionButton_Click" />
        </DockPanel>
    </Grid>
</Window>
