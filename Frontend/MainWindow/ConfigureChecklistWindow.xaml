<Window x:Class="SQLAuditor.Wpf.ConfigureChecklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Configure Checklist"
        Height="620"
        Width="760"
        MinHeight="480"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#FFF4F7FB"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FF0F4C81" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#FF1F2937" />
            <Setter Property="BorderBrush" Value="#FFCBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Add Configure Checklist"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#FF1F2937" />

        <TextBlock Grid.Row="1"
                   Text="Describe each custom check you want to add. The Area and Sub-area are chosen automatically from the title and description - you do not select them. Every entry is screened by the guardrails and checked against the existing checklist before a script is generated for your approval."
                   FontSize="13"
                   Foreground="#FF6B7280"
                   TextWrapping="Wrap"
                   Margin="0,6,0,16" />

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#FFE2E8F0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="EntriesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#FFE2E8F0"
                                    BorderThickness="0,0,0,1"
                                    Padding="4,10,4,14"
                                    Margin="0,0,0,6">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding Ordinal, StringFormat=Custom checklist item {0}}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FF0F4C81" />
                                        <Button DockPanel.Dock="Right"
                                                Content="Remove"
                                                Style="{StaticResource QuietButton}"
                                                Padding="10,2"
                                                FontSize="12"
                                                Tag="{Binding}"
                                                Click="RemoveEntry_Click" />
                                    </DockPanel>

                                    <TextBlock Text="Custom Checklist Title" Margin="0,10,0,4" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="6,4" />

                                    <TextBlock Text="Describe the Checklist Item" Margin="0,10,0,4" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="6,4"
                                             MinHeight="72"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3"
                   x:Name="StatusText"
                   Text=""
                   Foreground="#FFB91C1C"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0" />

        <DockPanel Grid.Row="4" LastChildFill="False" Margin="0,16,0,0">
            <Button DockPanel.Dock="Left"
                    x:Name="NewEntryBtn"
                    Content="New"
                    Style="{StaticResource QuietButton}"
                    MinWidth="110"
                    Click="NewEntryBtn_Click" />
            <Button DockPanel.Dock="Right"
                    x:Name="AddCustomChecklistBtn"
                    Content="Add Custom Checklist"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="190"
                    Click="AddCustomChecklistBtn_Click" />
            <Button DockPanel.Dock="Right"
                    x:Name="CancelBtn"
                    Content="Cancel"
                    Style="{StaticResource QuietButton}"
                    MinWidth="110"
                    Margin="0,0,10,0"
                    Click="CancelBtn_Click" />
        </DockPanel>
    </Grid>
</Window>
