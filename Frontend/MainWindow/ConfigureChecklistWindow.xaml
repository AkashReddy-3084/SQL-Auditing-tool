<Window x:Class="SQLAuditor.Wpf.ConfigureChecklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Custom Checklist Items"
        Height="720"
        Width="880"
        MinHeight="560"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#FFF4F7FB"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#FFD9E1EC" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF0F4C81" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF1268B3" />
        <SolidColorBrush x:Key="TextBrush" Color="#FF1F2937" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF6B7280" />
        <SolidColorBrush x:Key="HintBrush" Color="#FF9AA4B2" />

        <Style x:Key="ModernButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#FFF2F5FA" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style x:Key="RemoveButton" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
            <Setter Property="Foreground" Value="#FFB42318" />
            <Setter Property="Background" Value="#FFFDF3F2" />
            <Setter Property="BorderBrush" Value="#FFF3C6C1" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!-- TextBox that renders its Tag as placeholder text while empty. -->
        <Style x:Key="HintedTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <TextBlock x:Name="Hint"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{StaticResource HintBrush}"
                                           Margin="{TemplateBinding Padding}"
                                           FontSize="{TemplateBinding FontSize}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Top"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                              Focusable="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFB6C6DC" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="FieldHelp" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="StepPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Background" Value="#FFEEF4FB" />
            <Setter Property="BorderBrush" Value="#FFD3E2F2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      x:Name="PageScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
            <StackPanel>
                <TextBlock Text="Add Custom Checklist Items"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Add your own governance checks to the SQL Server audit checklist. Give each check a short title and a clear description of what should be verified - everything else is worked out for you."
                           FontSize="13"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />

                <Border Background="#FFF8FBFF"
                        BorderBrush="#FFD3E2F2"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16,12"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="What happens after you continue"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,0,0,8" />
                        <WrapPanel>
                            <Border Style="{StaticResource StepPill}">
                                <TextBlock Text="1. Guardrail screening" FontSize="12" Foreground="{StaticResource TextBrush}" />
                            </Border>
                            <Border Style="{StaticResource StepPill}">
                                <TextBlock Text="2. Duplicate check against the existing checklist" FontSize="12" Foreground="{StaticResource TextBrush}" />
                            </Border>
                            <Border Style="{StaticResource StepPill}">
                                <TextBlock Text="3. Automatic Area / Sub-area classification" FontSize="12" Foreground="{StaticResource TextBrush}" />
                            </Border>
                            <Border Style="{StaticResource StepPill}">
                                <TextBlock Text="4. Audit script generation" FontSize="12" Foreground="{StaticResource TextBrush}" />
                            </Border>
                            <Border Style="{StaticResource StepPill}">
                                <TextBlock Text="5. Your approval" FontSize="12" Foreground="{StaticResource TextBrush}" />
                            </Border>
                            <Border Style="{StaticResource StepPill}">
                                <TextBlock Text="6. Merge into the checklist" FontSize="12" Foreground="{StaticResource TextBrush}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="You do not choose the Area or Sub-area - they are derived from your title and description. Nothing is saved until you approve the generated script on the next screen."
                                   FontSize="11.5"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Expander Header="Show me a good example"
                          Foreground="{StaticResource PrimaryBrush}"
                          FontSize="12.5"
                          FontWeight="SemiBold"
                          Margin="0,12,0,0">
                    <Border Background="White"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,10"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap">
                                <Run Text="Title:" FontWeight="SemiBold" />
                                <Run Text="TLS 1.2 enforced for all client connections" FontWeight="Normal" />
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,6,0,0">
                                <Run Text="Description:" FontWeight="SemiBold" />
                                <Run FontWeight="Normal" Text="Verify that the SQL Server instance forces encrypted connections and that only TLS 1.2 or higher is enabled. The check should fail if ForceEncryption is off, or if TLS 1.0 / 1.1 are still enabled on the host." />
                            </TextBlock>
                            <TextBlock FontSize="11.5"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Text="Tip: state what to inspect and what counts as a pass or a fail. Avoid vague wording such as 'check security settings'." />
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- Items already captured. The container for the entry still being typed is collapsed here. -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,12"
                        Margin="0,14,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ItemsSource.Count, ElementName=AddedEntriesList}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ItemsSource, ElementName=AddedEntriesList}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Added items"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="4,0,4,2" />
                        <TextBlock Text="These are ready to go. Expand one to change its wording, or remove it from the batch."
                                   FontSize="11.5"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="4,0,4,10" />

                        <ItemsControl x:Name="AddedEntriesList">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF8FAFD"
                                            BorderBrush="#FFE4EAF2"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14,10,14,12"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <Border DockPanel.Dock="Left"
                                                        Background="{StaticResource PrimaryBrush}"
                                                        CornerRadius="999"
                                                        Width="24"
                                                        Height="24"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Ordinal}"
                                                               Foreground="White"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <Button DockPanel.Dock="Right"
                                                        Content="Remove"
                                                        Style="{StaticResource RemoveButton}"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Remove this custom checklist item from the batch"
                                                        Tag="{Binding}"
                                                        Click="RemoveEntry_Click" />
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="{Binding DisplayTitle}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13.5"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>

                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="34,4,0,0" />

                                            <Expander Header="Edit this item"
                                                      FontSize="12"
                                                      FontWeight="SemiBold"
                                                      Foreground="{StaticResource PrimaryBrush}"
                                                      Margin="34,8,0,0">
                                                <StackPanel Margin="0,6,0,0">
                                                    <TextBlock Text="Title" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                                    <TextBox Style="{StaticResource HintedTextBox}"
                                                             Tag="e.g. SQL Server Agent service is not running under a sysadmin account"
                                                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Text="Description" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                                    <TextBox Style="{StaticResource HintedTextBox}"
                                                             Tag="e.g. Confirm the account running the SQL Server Agent service is not a member of the sysadmin fixed server role. Fail if it is."
                                                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                             MinHeight="72"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             VerticalScrollBarVisibility="Auto" />
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- The entry currently being typed. Every other container is collapsed here. -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,12"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="4,0,4,10">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="New custom checklist item"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding ItemsSource.Count, ElementName=EntriesList, StringFormat={}{0} item(s) in this batch}"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <ItemsControl x:Name="EntriesList">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFBFCFE"
                                            BorderBrush="#FFE4EAF2"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14,12,14,14">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <Border DockPanel.Dock="Left"
                                                        Background="{StaticResource PrimaryBrush}"
                                                        CornerRadius="999"
                                                        Width="24"
                                                        Height="24"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Ordinal}"
                                                               Foreground="White"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="Custom checklist item"
                                                           FontWeight="SemiBold"
                                                           FontSize="13.5"
                                                           Foreground="{StaticResource TextBrush}"
                                                           VerticalAlignment="Center" />
                                                <Button DockPanel.Dock="Right"
                                                        Content="Remove"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Remove this custom checklist item from the batch"
                                                        Tag="{Binding}"
                                                        Click="RemoveEntry_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource RemoveButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRemovable}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DockPanel>

                                            <TextBlock Text="Title" Style="{StaticResource FieldLabel}" Margin="0,12,0,2" />
                                            <TextBlock Style="{StaticResource FieldHelp}"
                                                       Text="A short, specific name for the check. This is what appears in the audit report." />
                                            <TextBox Style="{StaticResource HintedTextBox}"
                                                     Tag="e.g. SQL Server Agent service is not running under a sysadmin account"
                                                     ToolTip="A short, specific name for the check"
                                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Text="Description" Style="{StaticResource FieldLabel}" Margin="0,12,0,2" />
                                            <TextBlock Style="{StaticResource FieldHelp}"
                                                       Text="Explain what to inspect on the SQL Server instance and what counts as a pass or a fail. The clearer this is, the better the generated audit script." />
                                            <TextBox Style="{StaticResource HintedTextBox}"
                                                     Tag="e.g. Confirm the account running the SQL Server Agent service is not a member of the sysadmin fixed server role. Fail if it is."
                                                     ToolTip="What to inspect, and what counts as a pass or a fail"
                                                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                     MinHeight="84"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" />
                                            <TextBlock Text="{Binding Description.Length, StringFormat={}{0} characters}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource HintBrush}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,4,2,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="#FFFDF3F2"
                BorderBrush="#FFF3C6C1"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,8"
                Margin="0,12,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=StatusText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="!"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="#FFB42318"
                           Margin="2,0,12,0"
                           VerticalAlignment="Top" />
                <TextBlock x:Name="StatusText"
                           Text=""
                           FontSize="12.5"
                           Foreground="#FFB42318"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,16,0,0">
            <Button DockPanel.Dock="Left"
                    x:Name="NewEntryBtn"
                    Content="Add another item"
                    Style="{StaticResource QuietButton}"
                    MinWidth="160"
                    ToolTip="Add one more custom checklist item to this batch"
                    Click="NewEntryBtn_Click" />
            <Button DockPanel.Dock="Right"
                    x:Name="AddCustomChecklistBtn"
                    Content="Continue"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="190"
                    IsDefault="True"
                    ToolTip="Screen these items, generate audit scripts, then review them before anything is saved"
                    Click="AddCustomChecklistBtn_Click" />
            <Button DockPanel.Dock="Right"
                    x:Name="CancelBtn"
                    Content="Cancel"
                    Style="{StaticResource QuietButton}"
                    MinWidth="110"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    ToolTip="Discard these items and close"
                    Click="CancelBtn_Click" />
        </DockPanel>
    </Grid>
</Window>
