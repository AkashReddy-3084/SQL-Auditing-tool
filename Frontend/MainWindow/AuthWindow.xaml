<Window x:Class="SQLAuditor.Wpf.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Authenticate" Height="220" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <RadioButton x:Name="RbWindowsAuth" Content="Windows Authentication" IsChecked="True" Margin="0,0,16,0" />
            <RadioButton x:Name="RbSqlAuth" Content="SQL Server Authentication" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,8">
            <TextBlock Text="Username" />
            <TextBox x:Name="UsernameBox" Width="360" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,0,0,8">
            <TextBlock Text="Password" />
            <PasswordBox x:Name="PasswordBox" Width="360" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="OK" Width="90" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
