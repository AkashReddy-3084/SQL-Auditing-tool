<Window x:Class="SQLAuditor.Wpf.ScriptGenerationProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generating Scripts"
        Height="560"
        Width="620"
        MinHeight="500"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow"
        Background="#FFF4F7FB"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Closing="Window_Closing">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   x:Name="HeaderText"
                   Text="Generating Scripts..."
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#FF1F2937"
                   Margin="0,0,0,6" />

        <TextBlock Grid.Row="1"
                   x:Name="CurrentItemText"
                   Text="Initializing..."
                   FontSize="13"
                   Foreground="#FF6B7280"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,0,0,16" />

        <!-- Progress bar -->
        <Grid Grid.Row="2" Margin="0,0,0,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar Grid.Row="0"
                         x:Name="ProgressBar"
                         Height="14"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Foreground="#FF0F4C81"
                         Background="#FFE9EEF5" />
            <TextBlock Grid.Row="1"
                       x:Name="ProgressText"
                       Text="0 / 0"
                       FontSize="12"
                       Foreground="#FF6B7280"
                       HorizontalAlignment="Right"
                       Margin="0,4,0,0" />
        </Grid>

        <!-- Counters -->
        <Border Grid.Row="3"
                Background="#FFFFFFFF"
                BorderBrush="#FFD9E1EC"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,14">
            <UniformGrid Columns="3">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Generated"
                               FontSize="12"
                               Foreground="#FF6B7280"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="GeneratedCount"
                               Text="0"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#FF1E8E3E"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Skipped"
                               FontSize="12"
                               Foreground="#FF6B7280"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="SkippedCount"
                               Text="0"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#FFE0A100"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Failed"
                               FontSize="12"
                               Foreground="#FF6B7280"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="FailedCount"
                               Text="0"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#FFD64545"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- Live log -->
        <TextBox Grid.Row="4"
                 x:Name="LogBox"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 MinHeight="160"
                 FontSize="11"
                 FontFamily="Consolas, Courier New"
                 Background="#FFFFFFFF"
                 BorderBrush="#FFD9E1EC"
                 BorderThickness="1"
                 Padding="8"
                 Margin="0,0,0,14" />

        <!-- Cancel / Close button -->
        <Button Grid.Row="5"
                x:Name="ActionButton"
                Content="Cancel"
                Width="120"
                MinHeight="36"
                HorizontalAlignment="Right"
                Click="ActionButton_Click"
                Foreground="White"
                Background="#FFB42318"
                BorderBrush="#FFB42318"
                BorderThickness="1"
                Padding="16,8"
                Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
