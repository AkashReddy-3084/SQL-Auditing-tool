<Window x:Class="SQLAuditor.Wpf.EvaluationsHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evaluations History" Height="560" Width="720"
        WindowStartupLocation="CenterOwner" Background="#FFF7FAFE">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Evaluations History" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="The 5 most recent evaluation runs across all servers. Rerun reuses the stored details; Edit lets you change the database, LLM, or manual CSV before running. Both overwrite the reports in the original run folder."
                       Foreground="#FF5B6B7F" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <TextBlock x:Name="EmptyText" Grid.Row="1"
                   Text="No previous evaluation runs were found."
                   Foreground="#FF5B6B7F" FontSize="13" Margin="0,16,0,0"
                   Visibility="Collapsed" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <ItemsControl x:Name="HistoryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#FFDCE6F2" BorderThickness="1"
                                CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Metadata.ServerName}" FontSize="15" FontWeight="SemiBold" />
                                        <Border Background="#FFE8F0F9" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ScoreDisplay}" FontSize="12" FontWeight="Bold" Foreground="#FF1D4ED8" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding EvaluatedDisplay}" Foreground="#FF5B6B7F" FontSize="12" Margin="0,4,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Metadata.ItemCount, StringFormat={}{0} items}" Foreground="#FF5B6B7F" FontSize="11" />
                                        <TextBlock Text="  •  " Foreground="#FF5B6B7F" FontSize="11" />
                                        <TextBlock Text="{Binding Metadata.Status}" Foreground="#FF5B6B7F" FontSize="11" />
                                        <TextBlock Text="  •  " Foreground="#FF5B6B7F" FontSize="11" />
                                        <TextBlock Text="{Binding DurationDisplay}" Foreground="#FF5B6B7F" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Rerun" Width="90" Height="34" Margin="0,0,8,0"
                                            Click="Rerun_Click" DataContext="{Binding}"
                                            ToolTip="Reuse the stored server, databases, and checklist; overwrite the reports in the same folder." />
                                    <Button Content="Edit" Width="90" Height="34"
                                            Click="Edit_Click" DataContext="{Binding}"
                                            ToolTip="Change the database, LLM details, or manual CSV, then rerun into the same folder." />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Close" Width="100" Height="34" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
