# Copy this file to .env and fill in real values. .env is git-ignored.

# Base URL of the OpenAI-compatible LLM endpoint (no trailing /chat/completions).
PROVIDER_BASE_URL=

# API key sent as the Bearer token. Never commit a real key.
PROVIDER_API_KEY=

# Model name passed to the provider.
MODEL=

# Optional. HTTP timeout for provider calls. Defaults to 240 when unset.
PROVIDER_TIMEOUT_SECONDS=240
